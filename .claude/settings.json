{
  "outputStyle": "simple-english",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pytest *)",
      "Bash(npm test *)",
      "Bash(npm run lint *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./dev/.env)",
      "Bash(rm -rf *)",
      "Bash(git push *)"
    ]
  }
}
